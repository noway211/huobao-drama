        <item name="colorPrimary">@color/zdrama_primary</item>
        <item name="colorPrimaryVariant">@color/zdrama_primary</item>
        <item name="colorOnPrimary">@color/zdrama_on_primary</item>
        <item name="android:windowBackground">@color/zdrama_black</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialButtonStyle">@style/Widget.Zdrama.Button</item>
    </style>

    <style name="Widget.Zdrama.Button" parent="Widget.MaterialComponents.Button">
