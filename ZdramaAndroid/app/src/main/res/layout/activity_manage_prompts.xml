<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zdrama_black"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/manage_prompts_title"
            android:textColor="@color/zdrama_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manage_prompts_close" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/manage_prompts_hint"
        android:textColor="@color/zdrama_text_secondary"
        android:textSize="13sp" />

    <!-- ─── 自定义 Tab 栏：3 个 tab 同时可见，active 用 primary 蓝 + 2dp 下划线 + bold，inactive 用 textSecondary ─── -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabScriptContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tabScriptLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_prompts_tab_script"
                android:textColor="@color/zdrama_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/tabScriptIndicator"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@color/zdrama_primary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabCharacterContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tabCharacterLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_prompts_tab_character"
                android:textColor="@color/zdrama_text_secondary"
                android:textSize="15sp" />

            <View
                android:id="@+id/tabCharacterIndicator"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabStoryboardContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/tabStoryboardLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/manage_prompts_tab_storyboard"
                android:textColor="@color/zdrama_text_secondary"
                android:textSize="15sp" />

            <View
                android:id="@+id/tabStoryboardIndicator"
                android:layout_width="28dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- ─── 脚本 tab (2 fields: 创作 + 改写) ─── -->
        <LinearLayout
            android:id="@+id/scriptPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/scriptCreateInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/manage_prompts_field_script_create_label"
                app:boxBackgroundColor="@color/zdrama_surface"
                app:boxStrokeColor="@color/zdrama_primary"
                app:helperTextEnabled="true"
                app:hintTextColor="@color/text_input_hint_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/scriptCreateInput"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:scrollbars="vertical"
                    android:textColor="@color/zdrama_text_primary"
                    android:textColorHint="@color/zdrama_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/scriptRewriteInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/manage_prompts_field_script_rewrite_label"
                app:boxBackgroundColor="@color/zdrama_surface"
                app:boxStrokeColor="@color/zdrama_primary"
                app:helperTextEnabled="true"
                app:hintTextColor="@color/text_input_hint_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/scriptRewriteInput"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:scrollbars="vertical"
                    android:textColor="@color/zdrama_text_primary"
                    android:textColorHint="@color/zdrama_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetScriptButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/manage_prompts_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveScriptButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/manage_prompts_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ─── 角色提取 tab (1 field) ─── -->
    <ScrollView
        android:id="@+id/characterPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/characterExtractInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/manage_prompts_field_character_extract_label"
                app:boxBackgroundColor="@color/zdrama_surface"
                app:boxStrokeColor="@color/zdrama_primary"
                app:helperTextEnabled="true"
                app:hintTextColor="@color/text_input_hint_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/characterExtractInput"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:scrollbars="vertical"
                    android:textColor="@color/zdrama_text_primary"
                    android:textColorHint="@color/zdrama_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetCharacterButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/manage_prompts_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveCharacterButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/manage_prompts_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ─── 分镜 tab (1 field) ─── -->
    <ScrollView
        android:id="@+id/storyboardPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/storyboardInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/manage_prompts_field_storyboard_label"
                app:boxBackgroundColor="@color/zdrama_surface"
                app:boxStrokeColor="@color/zdrama_primary"
                app:helperTextEnabled="true"
                app:hintTextColor="@color/text_input_hint_color">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/storyboardInput"
                    android:layout_width="match_parent"
                    android:layout_height="500dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:scrollbars="vertical"
                    android:textColor="@color/zdrama_text_primary"
                    android:textColorHint="@color/zdrama_text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetStoryboardButton"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/manage_prompts_reset" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/saveStoryboardButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/manage_prompts_save" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/zdrama_text_secondary"
        android:textSize="12sp" />
</LinearLayout>
