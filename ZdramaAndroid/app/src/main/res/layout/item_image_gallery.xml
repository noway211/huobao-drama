<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@color/zdrama_surface"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:id="@+id/shotImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@color/zdrama_black"
        android:contentDescription="@string/project_image_gallery_title"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/shotTitleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/zdrama_text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/shotStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/zdrama_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/deleteImageButton"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/project_image_delete_one"
        android:visibility="gone" />
</LinearLayout>
